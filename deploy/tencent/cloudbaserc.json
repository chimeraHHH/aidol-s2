{
  "envId": "REPLACE_WITH_YOUR_ENV_ID",
  "region": "ap-guangzhou",
  "version": "2.0",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "framework": {
    "name": "wozhi",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "cd ../../app && npm install --legacy-peer-deps && npm run build",
          "outputPath": "../../app/dist",
          "cloudPath": "/",
          "ignore": ["node_modules/**"]
        }
      }
    }
  }
}
