# HTTP
PORT=8787
CORS_ORIGIN=http://localhost:5173

# GPT 生图 / 视频网关（优先）
# 控制台：https://draw.openai-next.com
DRAW_API_KEY=
DRAW_BASE_URL=https://draw.openai-next.com/v1
DRAW_IMAGE_MODEL=gpt-image-1
DRAW_IMAGE_SIZE=1024x1536
# 生视频：doubao-seedance-2-0-mini-260615（已通）；sora-2-hd 可能价目未配置
DRAW_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
DRAW_VIDEO_SIZE=720x1280

# 火山方舟（未配 DRAW 时回退）
ARK_API_KEY=
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDREAM_MODEL=doubao-seedream-4-5-251128
ARK_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_POLL_MS=4000
SEEDANCE_TIMEOUT_MS=720000
COMPANION_VIDEO_DURATION_SEC=5

# 陪伴对话：OpenAI 兼容
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai-next.com
CHAT_MODEL=gpt-4o-mini

ALLOW_MOCK_AVATAR=true
