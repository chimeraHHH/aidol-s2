  "global_safety_rules": [
    "不根据单次重量判断健康",
    "不根据品种参考范围单独判断肥胖",
    "不把统计相关表达为必然因果",
    "不根据体重变化诊断具体疾病",
    "数据不足时先追问，不输出伪精确结论",
    "优先使用个人历史趋势",
    "兽医确认的BCS和目标体重优先于用户自评",
